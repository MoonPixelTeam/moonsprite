{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoonSprite",
  "version": "1.0.0-beta2",
  "identifier": "art.moonpx.moonsprite",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:web && pnpm build:thumbnail",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "MoonSprite 1.0.0-beta2",
        "width": 1440,
        "height": 900,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0f1116"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Windows pixel art editor",
    "resources": {
      "thumbnail-provider/target/release/moonsprite_thumbnail.dll": "moonsprite_thumbnail.dll",
      "resources/moonsprite-file.ico": "moonsprite-file.ico",
      "resources/fonts/licenses/Fusion-Pixel-Font-OFL-1.1.txt": "font-licenses/Fusion-Pixel-Font-OFL-1.1.txt",
      "resources/fonts/licenses/Silkscreen-OFL-1.1.txt": "font-licenses/Silkscreen-OFL-1.1.txt",
      "resources/fonts/licenses/Tiny5-OFL-1.1.txt": "font-licenses/Tiny5-OFL-1.1.txt"
    },
    "fileAssociations": [
      {
        "ext": ["moonsprite"],
        "name": "MoonSprite Project",
        "description": "MoonSprite pixel art project",
        "role": "Editor",
        "mimeType": "application/x-moonsprite"
      },
      {
        "ext": ["msext"],
        "name": "MoonSprite Extension",
        "description": "MoonSprite extension package",
        "role": "Editor",
        "mimeType": "application/x-msext"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/thumbnail-provider.nsh"
      }
    }
  }
}
