+    for(int y=rc.y;y<rc.y2();y+=cell) for(int x=rc.x;x<rc.x2();x+=cell)
+      g.fillRect(((x-rc.x)/cell+(y-rc.y)/cell)%2?light:dark,gfx::Rect(x,y,std::min(cell,rc.x2()-x),std::min(cell,rc.y2()-y)));
