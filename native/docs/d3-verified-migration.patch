+  const auto color=skin_[isEnabled()?"text":"muted"];
+  if(iconSkin && !icon.empty()) iconSkin->draw(g,icon+(isEnabled()?"":"-disabled"),gfx::Rect(content.x,content.y+(content.h-11)/2,11,11),true);
+  font_.draw(g,caption_,content.x+menuIconGutter(*this,inBar())-captionInk.x,textY,color);
+  if(!inBar()) {
+    font_.draw(g,shortcut_,content.x2()-shortcutInk.w-shortcutInk.x,textY,skin_["muted"]);
+    if(checked && checked()) font_.draw(g,U"*",content.x,textY,color);
