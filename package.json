{
  "name": "moonsprite",
  "version": "1.0.0-beta2",
  "description": "An original, source-available pixel art workstation for Windows.",
  "author": "MoonSprite contributors",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:web": "vite --config vite.config.ts",
    "build": "tauri build",
    "build:thumbnail": "cargo build --manifest-path src-tauri/thumbnail-provider/Cargo.toml --release",
    "build:web": "vite build --config vite.config.ts",
    "build:web:performance": "vite build --config vite.config.ts --mode performance-production",
    "build:web:performance-profile": "vite build --config vite.config.ts --mode performance-profile",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tauri": "node scripts/tauri-smoke.mjs",
    "test:desktop": "node scripts/desktop-regression.mjs",
    "check:dev": "node scripts/run-validation.mjs dev",
    "check:release": "node scripts/run-validation.mjs release",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "check:architecture": "node scripts/architecture-contract.mjs",
    "check:version": "node scripts/check-version-contract.mjs",
    "check:performance": "node scripts/run-performance-audit.mjs",
    "check:performance:release": "node scripts/run-performance-audit.mjs --release",
    "check:performance:verify": "node scripts/verify-performance-optimization.mjs",
    "check:performance:accept": "node scripts/accept-performance-audit.mjs",
    "check:performance:receipt": "node scripts/check-performance-release.mjs",
    "bench:canvas": "pnpm build:web:performance && node scripts/canvas-performance.mjs",
    "bench:canvas:full": "pnpm bench:canvas -- --full",
    "bench:canvas:profile": "pnpm build:web:performance-profile && node scripts/canvas-performance.mjs --runtime=profile",
    "bench:canvas:large": "pnpm bench:canvas -- --size=800,2048,4000 --scenario=large-pan,large-zoom,large-draw,large-shape,large-marquee,large-bucket-fill,large-gradient,large-detail-pan,large-detail-draw,large-detail-draw-timelapse",
    "bench:selection": "vitest bench src/renderer/src/core/selection-performance.bench.ts --run",
    "bench:document": "vitest bench src/renderer/src/core/document-performance.bench.ts --run",
    "check:maintenance": "node --test scripts/architecture-contract.test.mjs scripts/canvas-performance-options.test.mjs scripts/changelog-policy.test.mjs scripts/csp-policy.test.mjs scripts/dev-validation-policy.test.mjs scripts/module-boundaries.test.mjs scripts/performance-acceptance.test.mjs scripts/performance-analysis.test.mjs scripts/performance-audit-store.test.mjs scripts/performance-build-contract.test.mjs scripts/performance-scope-rules.test.mjs scripts/validation-scope.test.mjs scripts/version-contract.test.mjs && node scripts/architecture-contract.mjs && node scripts/check-maintenance-contract.mjs",
    "package": "tauri build && pnpm package:prepare && pnpm package:size",
    "package:prepare": "node scripts/prepare-release.mjs",
    "package:size": "node scripts/check-package-size.mjs",
    "preview": "vite preview --config vite.config.ts",
    "website:dev": "pnpm --dir website dev",
    "website:build": "pnpm --dir website build",
    "website:capture": "node website/scripts/capture-product.mjs"
  },
  "dependencies": {
    "ag-psd": "31.0.2",
    "gifuct-js": "2.1.2"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/upng-js": "2.1.5",
    "@vitejs/plugin-react": "6.0.4",
    "fflate": "0.8.3",
    "jsdom": "29.1.1",
    "lucide-react": "1.26.0",
    "playwright": "1.62.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "upng-js": "2.1.0",
    "zustand": "5.0.14"
  },
  "packageManager": "pnpm@11.9.0"
}
